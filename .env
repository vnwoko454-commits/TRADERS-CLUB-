
==========================================================

VANKLEFF SOLANA HUNTER — BACKEND ENVIRONMENT

File name must be exactly: .env

==========================================================

--- Solana RPC ---

RPC_HTTPS_URL=https://mainnet.helius-rpc.com/?api-key=PUT_YOUR_KEY_HERE
RPC_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=PUT_YOUR_KEY_HERE

--- Wallet (LEAVE EMPTY until you go live) ---

WALLET_PRIVATE_KEY=

--- Telegram ---

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

--- Trading safety ---

LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=

--- Server ---

PORT=8080
MONITOR_INTERVAL_MS=10000

--- Security / scoring ---

RUGCHECK_API_KEY=
RUGCHECK_MAX_SCORE=40

--- Fallback FX ---

SOL_NGN_RATE=180000
